{
  "name": "drlocks-nfl-props",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dfs:projections": "python3 scripts/diagnose_dfs_projections.py",
    "dfs:diagnose": "python3 scripts/diagnose_dk_salaries.py",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply playerprop-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply playerprop-db --remote",
    "check": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs && python3 -m unittest discover -s tests -p 'test_*.py'",
    "dfs:lineups": "node scripts/build_dfs_lineups.mjs",
    "dfs:simulate": "node scripts/simulate_dfs.mjs",
    "dfs:simulation-input": "node scripts/build_simulation_input.mjs",
    "dfs:calibrate": "node scripts/validate_dfs_simulation.mjs",
    "dfs:benchmark": "node scripts/benchmark_dfs_simulation.mjs",
    "dfs:research": "python3 scripts/prepare_dfs_research.py",
    "dfs:freeze": "node scripts/freeze_dfs_research.mjs",
    "dfs:evaluate": "node scripts/evaluate_frozen_dfs.mjs",
    "dfs:refresh": "python3 scripts/refresh_current_research.py",
    "dfs:calibrate:historical": "node scripts/calibrate_historical_mc.mjs",
    "dfs:calibrate:prepare": "python3 scripts/prepare_historical_calibration.py",
    "news:refresh": "python3 scripts/refresh_newsroom.py",
    "v2:benchmark": "node scripts/benchmark_v2.mjs",
    "v2:prepare": "python3 scripts/prepare_v2_example.py",
    "v2:simulate": "node scripts/simulate_v2.mjs",
    "v2:fit": "python3 scripts/fit_v2_pbp.py",
    "v2:evaluate": "node scripts/evaluate_v2_b.mjs",
    "drive-lab:build": "node scripts/build_drive_lab.mjs",
    "personnel:import": "python3 scripts/import_personnel.py",
    "personnel:build": "python3 scripts/build_personnel.py",
    "personnel:diagnose": "python3 scripts/diagnose_personnel.py",
    "v2:live:refresh": "python3 scripts/refresh_v2_live.py",
    "v2:live:build": "python3 scripts/build_v2_live.py"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260903.1",
    "esbuild": "0.28.1",
    "typescript": "^5.9.0",
    "wrangler": "^4.128.0"
  }
}
